{
  "manifest_version": 3,
  "name": "Codxis Guard - Senha do Gerente",
  "version": "1.7.1",
  "description": "Exige a senha do gerente para cancelar venda, remover item, alterar preço e dar desconto no PDV web da Codxis.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Opções do Codxis Guard",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://web.codxis.api.br/*"],
      "js": ["scripts/common.js", "scripts/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
